// ==================== PRICING ====================
section.section.pricing#pricing
  .container
    .section-header.reveal.reveal-1
      span.section-label 潛水艇計畫 · 租借費用
      h2.section-title
        | 透明
        span.text-gold 定價方案
      span.gold-line
      p.section-subtitle 彈性方案，非營利組織另有優惠

    .pricing__grid
      //- Weekday
      .pricing-card.reveal.reveal-1
        .pricing-card__glow
        span.pricing-card__icon 🌙
        h3.pricing-card__title 平日方案
        p.pricing-card__period 週一至週五 18:00 前
        .pricing-card__price
          span.pricing-card__currency NT$
          span.pricing-card__amount 350
          span.pricing-card__unit / 小時
        .pricing-card__divider
        ul.pricing-card__perks
          li 全場獨立使用
          li 落地鏡面、木質地板
          li 彈性時段安排
          li 最小租借單位 1 小時

      //- Weekend – Featured
      .pricing-card.pricing-card--featured.reveal.reveal-2
        .pricing-card__glow
        span.pricing-card__icon ☀️
        h3.pricing-card__title 晚間／週末方案
        p.pricing-card__period 平日 18:00 起、週末全天
        .pricing-card__price
          span.pricing-card__currency NT$
          span.pricing-card__amount 400
          span.pricing-card__unit / 小時
        .pricing-card__divider
        ul.pricing-card__perks
          li 全場獨立使用
          li 落地鏡面、木質地板
          li 跨 18:00 自動分段計費
          li 可搭配優惠時段折抵

      //- Time-based discounts
      .pricing-card.reveal.reveal-3
        .pricing-card__glow
        span.pricing-card__icon ⏱️
        h3.pricing-card__title 優惠時段方案
        p.pricing-card__period 完整涵蓋指定時段
        .pricing-card__price
          span.pricing-card__currency NT$
          span.pricing-card__amount 100
          span.pricing-card__unit 元折抵
        .pricing-card__divider
        ul.pricing-card__perks
          li 09:00–13:00
          li 13:30–17:30
          li 18:00–22:00
          li 連續滿 8 小時可折 NT$250
        p.pricing-card__note 每次租借擇一優惠，不重複折抵

    //- Nonprofit banner
    .pricing__nonprofit.reveal.reveal-4
      .pricing__nonprofit-icon 🤝
      div
        h3.pricing__nonprofit-title 非營利組織優惠方案
        p.pricing__nonprofit-text
          | 非營利組織可洽談合作專案，優惠資格與費用由場地方確認。
          br
          | 歡迎主動聯繫討論長期合作！
